      <media:content url="https://blog.gitbutler.com/_next/image?url=https%3A%2F%2Fd2m1ukvwmu7gz4.cloudfront.net%2FCleanShot%25202026-06-09%2520at%252018.01.02%25402x.png&amp;w=3840&amp;q=75" medium="image" />
      <media:content url="https://blog.gitbutler.com/_next/image?url=https%3A%2F%2Fd2m1ukvwmu7gz4.cloudfront.net%2FCleanShot%25202026-06-08%2520at%252021.17.01%25402x.png&amp;w=3840&amp;q=75" medium="image" />
      <media:content url="https://blog.gitbutler.com/_next/image?url=https%3A%2F%2Fd2m1ukvwmu7gz4.cloudfront.net%2FCleanShot%25202026-06-03%2520at%252015.06.40%25402x.png&amp;w=3840&amp;q=75" medium="image" />
