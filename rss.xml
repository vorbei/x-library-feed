      <media:content url="https://cdn.sanity.io/images/yd6zslid/production/403b27201942803569c397a7f584d42dc3a64e21-2568x1737.png?fm=webp&amp;h=1082&amp;w=1600&amp;auto=format&amp;fit=min&amp;q=75" medium="image" />
